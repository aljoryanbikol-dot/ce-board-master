{
  // The serverless entry lives outside src/, which the Nest build pins as its
  // rootDir. Vercel compiles functions with the nearest tsconfig, so give this
  // directory its own that keeps the same compiler options minus rootDir.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    // The code calls global fetch (Resend delivery). Locally the installed
    // @types/node supplies Response/fetch, but Vercel's build resolves a
    // toolchain where it does not, so declare DOM explicitly rather than
    // depending on which @types/node the platform happens to pick.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["./**/*", "../src/**/*"]
}
